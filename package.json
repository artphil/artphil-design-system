{
  "name": "artphil-design-system",
  "version": "1.4.0",
  "description": "Design System for Artphil's projects",
  "main": "index.css",
  "style": "index.css",
  "files": [
    "index.css",
    "tokens",
    "base",
    "theme",
    "components"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.css\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run format:check && npm run lint:css && npm run check:tokens",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artphil/artphil-design-system.git"
  },
  "keywords": [
    "artphil",
    "ap-ds"
  ],
  "author": "Arthur Phillip Silva - artphil",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/artphil/artphil-design-system/issues"
  },
  "homepage": "https://github.com/artphil/artphil-design-system#readme",
  "devDependencies": {
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
