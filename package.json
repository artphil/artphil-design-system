{
  "name": "artphil-design-system",
  "version": "2.0.0",
  "description": "Design System for Artphil's projects",
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./tokens": "./tokens/index.css",
    "./tokens/*.css": "./tokens/*.css",
    "./base": "./base/index.css",
    "./base/*.css": "./base/*.css",
    "./theme": "./theme/index.css",
    "./theme/*.css": "./theme/*.css",
    "./components": "./components/index.css",
    "./components/*.css": "./components/*.css",
    "./package.json": "./package.json"
  },
  "main": "index.css",
  "style": "index.css",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "index.css",
    "tokens",
    "base",
    "theme",
    "components"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.css\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run format:check && npm run lint:css && npm run check:tokens",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artphil/artphil-design-system.git"
  },
  "keywords": [
    "artphil",
    "ap-ds"
  ],
  "author": "Arthur Phillip Silva - artphil",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/artphil/artphil-design-system/issues"
  },
  "homepage": "https://github.com/artphil/artphil-design-system#readme",
  "devDependencies": {
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
